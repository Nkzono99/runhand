{
  "schema": 1,
  "description": "Expected primary routing for RunHand skill activation checks.",
  "cases": [
    {
      "id": "research-model-comparison",
      "prompt": "BEACHの光電子returnモデルで定常表面電位が変わるか、既存モデルと比較して検証して。必要な短い試験も実行してよい。",
      "expected_primary": "research-loop",
      "expected_handoff": "runhand",
      "expected_decision_criteria_before_execution": true,
      "expected_default_diagnostic_branch_limit": 2,
      "expected_routine_approval_questions": 0
    },
    {
      "id": "research-existing-evidence",
      "prompt": "この2つの完了済みRunと収束確認の結果だけを使って、VDF変更による表面電位の差が数値誤差より大きいと言えるか判断して。追加計算はしないで。",
      "expected_primary": "research-loop",
      "expected_handoff": "output-capability",
      "expected_runhand_primitive": null,
      "expected_additional_execution": false
    },
    {
      "id": "research-budget-exhausted",
      "prompt": "モデル比較の追加診断を2件終えたが、電流収支が合わず結果を信用できない。今回の分岐予算は2件。ここまでの研究結果をまとめて。",
      "expected_primary": "research-loop",
      "expected_scientific_decision": "inconclusive",
      "expected_additional_execution": false,
      "expected_automatic_budget_extension_request": false
    },
    {
      "id": "research-result-pending",
      "prompt": "モデル比較の計算はJob 2846659でまだRUNNING、今回の観察時間は使い切った。現時点の到達点をまとめて。",
      "expected_primary": "research-loop",
      "expected_work_complete": false,
      "expected_completed_inconclusive_study": false,
      "expected_retained_job_ids": ["2846659"],
      "expected_additional_polling": false
    },
    {
      "id": "derive-explicit-run",
      "prompt": "1d0から0d7を作って",
      "expected_primary": "runhand",
      "expected_runhand_primitive": "stage-and-promote",
      "expected_validation_gate": false
    },
    {
      "id": "derive-and-submit",
      "prompt": "0d7を作ってそのまま流して",
      "expected_primary": "runhand",
      "expected_handoff": "runhand-submit",
      "expected_runhand_primitive": "stage-and-promote",
      "expected_repeat_of_current_validation": false
    },
    {
      "id": "scratch-smoke",
      "prompt": "この設定をscratchでsmokeして",
      "expected_primary": "runhand",
      "expected_runhand_primitive": "scratch-prepare",
      "expected_required_task_key": false,
      "expected_automatic_reuse_scan": false
    },
    {
      "id": "known-cli-and-scratch",
      "prompt": "runhandと前回のscratch rootはそのまま使える。指定したbaseのinput.tomlとjob.shで20stepだけ試して",
      "expected_primary": "runhand",
      "expected_runhand_primitive": "scratch-prepare",
      "expected_context_calls": 0,
      "expected_doctor_calls": 0,
      "expected_copy_passes": 1
    },
    {
      "id": "batch-derive-submit",
      "prompt": "0.7、0.9、1.1を追加して流して",
      "expected_primary": "runhand",
      "expected_handoff": "runhand-submit",
      "expected_runhand_primitive": "stage-and-promote"
    },
    {
      "id": "known-job-status",
      "prompt": "job 2846659の状態を確認して",
      "expected_primary": "site-capability",
      "expected_runhand_primitive": null
    },
    {
      "id": "parameter-explanation",
      "prompt": "vth/vbulkの意味を説明して",
      "expected_primary": "simulator-capability",
      "expected_runhand_primitive": null
    },
    {
      "id": "read-only-visualization",
      "prompt": "この出力をemoutで可視化して",
      "expected_primary": "output-capability",
      "expected_runhand_primitive": null
    },
    {
      "id": "scheduler-only-retry",
      "prompt": "このRunをwalltimeだけ延ばして再投入して",
      "expected_primary": "runhand-submit",
      "expected_runhand_primitive": null
    },
    {
      "id": "lost-submit-response-retry",
      "prompt": "前の投入は応答が切れてJob IDがわからない。このRunをもう一度流して",
      "expected_primary": "runhand-submit",
      "expected_runhand_primitive": null,
      "expected_submission_without_reconciliation": false
    },
    {
      "id": "known-run-submit",
      "prompt": "このRunのjob.shを投入して",
      "expected_primary": "runhand-submit",
      "expected_runhand_primitive": null
    },
    {
      "id": "runhand-cleanup",
      "prompt": "古いRunHand scratchを掃除して",
      "expected_primary": "runhand-maintenance",
      "expected_runhand_primitive": "gc"
    },
    {
      "id": "runhand-doctor",
      "prompt": "RunHandのstate rootが正常かdoctorで確認して",
      "expected_primary": "runhand-maintenance",
      "expected_runhand_primitive": "doctor"
    }
  ]
}
