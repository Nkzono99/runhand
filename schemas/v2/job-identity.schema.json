{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Nkzono99/runhand/schemas/v2/job-identity.schema.json",
  "title": "RunHand scheduler job identity v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["site", "cluster", "job_id", "submit_time"],
  "properties": {
    "site": {"type": "string", "minLength": 1},
    "cluster": {"type": "string", "minLength": 1},
    "job_id": {"type": "string", "minLength": 1},
    "submit_time": {"type": "string", "format": "date-time"}
  }
}
