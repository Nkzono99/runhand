{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Nkzono99/runhand/schemas/v1/cli-envelope.schema.json",
  "title": "RunHand CLI envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "ok", "command", "data", "warnings", "errors"],
  "properties": {
    "schema": {"const": 1},
    "ok": {"type": "boolean"},
    "command": {"type": "string"},
    "data": {"type": "object"},
    "warnings": {"type": "array", "items": {"$ref": "#/$defs/diagnostic"}},
    "errors": {"type": "array", "items": {"$ref": "#/$defs/diagnostic"}}
  },
  "$defs": {
    "diagnostic": {
      "type": "object",
      "required": ["code", "message", "retryable"],
      "properties": {
        "code": {"type": "string"},
        "message": {"type": "string"},
        "retryable": {"type": "boolean"},
        "path": {"type": "string"},
        "details": {"type": "object"}
      }
    }
  }
}
