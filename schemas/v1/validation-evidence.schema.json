{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Nkzono99/runhand/schemas/v1/validation-evidence.schema.json",
  "title": "RunHand validation evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "target", "profile", "result", "input_revision", "validator"],
  "properties": {
    "schema": {"const": 1},
    "target": {"type": "string"},
    "profile": {"type": "string"},
    "result": {"enum": ["valid", "invalid", "unknown", "unavailable"]},
    "input_revision": {"type": ["object", "null"]},
    "validator": {
      "type": ["object", "null"],
      "properties": {
        "identity": {"type": "string"},
        "version": {"type": "string"}
      }
    },
    "messages": {"type": "array", "items": {"type": "object"}}
  }
}
